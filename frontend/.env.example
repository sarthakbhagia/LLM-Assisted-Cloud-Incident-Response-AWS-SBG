# Base URL of the deployed dashboard API Gateway stage
VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/Prod

# Base URL of the deployed demo-control API Gateway stage
# (fault injection + demo approval). Leave unset in local dev —
# the Vite dev-server proxy routes /demo to localhost:3002.
VITE_DEMO_API_BASE_URL=https://<demo-api-id>.execute-api.<region>.amazonaws.com/Prod
